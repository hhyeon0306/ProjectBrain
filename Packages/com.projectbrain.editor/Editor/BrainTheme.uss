.brain { background-color: #303234; color: #e2e3e5; font-size: 13px; }
.brain Button { background-color: #3b3d40; color: #dedfe3; border-width: 1px; border-color: #55585e; border-radius: 5px; min-height: 29px; padding-left: 12px; padding-right: 12px; margin: 3px; }
.brain Button:hover { background-color: #484b51; border-color: #a6b4eb; }
.brain Button:focus { border-color: #a6b4eb; }
.brain Button:disabled { opacity: 0.4; }
.brain .quiet { background-color: rgba(0,0,0,0); border-color: rgba(0,0,0,0); }
.brain .primary { background-color: #a6b4eb; color: #252833; border-color: #a6b4eb; -unity-font-style: bold; }
.brain .primary:hover { background-color: #bcc7f3; }
.brain .active { color: #b8c4f4; border-color: #8595ce; background-color: #3b414f; }
.brain .muted { color: #a8abb1; font-size: 11px; white-space: normal; }
.brain .headline { font-size: 27px; margin-bottom: 10px; margin-top: 6px; }
.brain .eyebrow { color: #a8abb1; font-size: 10px; margin-bottom: 8px; }
.brain .bar { flex-direction: row; align-items: center; background-color: #292b2d; padding: 7px 12px; min-height: 42px; }
.brain .bar .brand { font-size: 15px; margin-right: 20px; }
.brain .search { width: 265px; margin-left: 8px; margin-right: 8px; }
.brain .unity-base-text-field__input { background-color: #292b2e; color: #e2e3e5; border-width: 1px; border-color: #54575e; border-radius: 4px; padding: 6px 8px; }
.brain .unity-base-text-field__input:focus { border-color: #a6b4eb; }
.brain .unity-base-field__label { color: #bfc2c9; }
.brain .unity-toggle__label { white-space: normal; }
.brain .unity-help-box { background-color: #393c42; border-color: #555b68; border-radius: 5px; padding: 8px; }
.brain .unity-help-box__text { color: #d7d9df; white-space: normal; }
.brain .floating { position: absolute; background-color: #3b3d40; border-width: 1px; border-color: #575a60; border-radius: 7px; padding: 14px; }
.brain .inspector { right: 20px; bottom: 72px; width: 304px; max-height: 380px; }
.brain .inspector .detail-title { font-size: 21px; white-space: normal; margin-bottom: 9px; }
.brain .inspector Button { -unity-text-align: middle-left; white-space: normal; height: auto; padding-top: 5px; padding-bottom: 5px; }
.brain .map-heading { position: absolute; left: 32px; top: 26px; }
.brain .map-heading .headline { font-size: 32px; }
.brain .map-modes { position: absolute; top: 26px; right: 20px; flex-direction: row; }
.brain .map-tools { position: absolute; bottom: 22px; left: 28%; flex-direction: row; align-items: center; padding: 3px 6px; }
.brain .map-legend { position: absolute; bottom: 4px; left: 16px; color: #b5b8bf; font-size: 10px; }
.brain .map-count { position: absolute; top: 108px; left: 34px; color: #b5b8bf; font-size: 11px; }
.brain .node-label { position: absolute; height: 28px; min-height: 28px; max-width: 164px; padding: 0 4px; margin: 0; background-color: rgba(0,0,0,0); border-width: 0; border-radius: 3px; font-size: 12px; -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; }
.brain .node-label:hover { background-color: #454950; }
.brain .node-label.selected { color: #c5cff6; -unity-font-style: bold; }
.brain .node-label.node-root { font-size: 16px; -unity-font-style: bold; max-width: 200px; }
.brain .node-label.node-domain { font-size: 14px; -unity-font-style: bold; max-width: 200px; }
.brain .filter-panel { top: 74px; right: 20px; width: 220px; }
.brain .summary-panel { right: 20px; top: 22px; bottom: 76px; width: 420px; }
.brain .section { margin-top: 14px; margin-bottom: 10px; padding: 12px; border-top-width: 1px; border-top-color: #50535a; }
.brain .document-page { padding: 22px 28px; }
.brain .document-page TextField { margin-bottom: 12px; }
.brain .document-page .unity-base-text-field__input { background-color: #333538; border-color: #494c52; padding: 12px; }
.brain .document-page .unity-base-text-field__input:focus { border-color: #a6b4eb; }
.brain .document-page Label { white-space: normal; }
.brain .task-body { padding: 12px 20px; }
.brain .task-body Foldout { margin-top: 12px; padding: 12px; border-top-width: 1px; border-top-color: #50535a; }
.brain .unity-label { white-space: normal; }
.brain Button { white-space: normal; height: auto; padding-top: 5px; padding-bottom: 5px; }
.brain .single-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex-shrink: 1; color: #b5b8bf; }
.brain .node-label { white-space: nowrap; height: 28px; padding-top: 0; padding-bottom: 0; }
.brain .row { flex-direction: row; align-items: center; }
.brain .stacked-field { flex-direction: column; margin-top: 8px; margin-bottom: 16px; }
.brain .stacked-field > .unity-base-field__label { min-width: 0; width: auto; margin-bottom: 7px; font-size: 13px; -unity-font-style: bold; }
.brain .stacked-field .unity-base-text-field__input { white-space: normal; min-width: 0; padding: 12px; }
.brain .stacked-field .unity-text-element { white-space: normal; }
.brain .doc-header { padding: 20px 26px 14px 26px; background-color: #2b2d30; flex-shrink: 0; }
.brain .doc-header .unity-object-field { margin-top: 14px; }
.brain .doc-title { font-size: 24px; -unity-font-style: bold; white-space: normal; margin-bottom: 6px; }
.brain .save-state { color: #bdc6e4; margin-left: 20px; font-size: 12px; white-space: nowrap; }
.brain .save-state.unsaved { color: #e8bf78; }
.brain .doc-tabs { flex-direction: row; padding: 7px 22px; border-bottom-width: 1px; border-bottom-color: #4b4e54; flex-shrink: 0; }
.brain .doc-tabs Button { min-height: 34px; margin-right: 12px; }
.brain .doc-footer { flex-direction: row; align-items: center; padding: 10px 20px; background-color: #292b2d; flex-shrink: 0; }
.brain .doc-footer .muted { min-width: 0; flex-shrink: 1; margin-right: 12px; }
.brain .doc-footer Button { min-width: 80px; }
.brain .storage-note { color: #b2b6c0; font-size: 11px; white-space: normal; padding: 7px 24px; background-color: #292b2d; flex-shrink: 0; }
.brain .section-title { font-size: 19px; -unity-font-style: bold; margin-bottom: 8px; }
.brain .section-description { color: #afb4bf; font-size: 12px; white-space: normal; margin-bottom: 20px; }
.brain .empty-guide { color: #b9bdc7; font-size: 14px; white-space: normal; margin: 28px 0; }
.brain .resource-card { margin-top: 16px; padding: 16px; border-width: 1px; border-color: #51555e; border-radius: 6px; background-color: #333639; }
.brain .resource-title { font-size: 15px; -unity-font-style: bold; white-space: normal; margin-bottom: 6px; }
.brain .document-window .unity-help-box { margin: 4px 20px; flex-shrink: 0; }
.brain .structure-body { flex-grow: 1; min-height: 0; flex-direction: row; }
.brain .domain-navigation { width: 185px; flex-shrink: 0; padding: 16px 10px; background-color: #292b2d; border-right-width: 1px; border-right-color: #46494f; }
.brain .navigation-item { white-space: normal; -unity-text-align: middle-left; min-height: 32px; }
.brain .domain-navigation .eyebrow { margin-top: 4px; margin-bottom: 12px; }
.brain .structure-inspector { width: 310px; flex-shrink: 0; padding: 14px; background-color: #35373b; border-left-width: 1px; border-left-color: #55585e; }
.brain .structure-inspector .detail-title { font-size: 20px; margin-bottom: 12px; }
.brain .selection-bar { flex-direction: row; align-items: center; padding: 6px 14px; min-height: 40px; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: #46494f; }
.brain .map-heading { top: 16px; left: 24px; }
.brain .scope-title { font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.brain .map-count { top: 45px; left: 26px; }
.brain .map-modes { top: 12px; }
.brain .map-tools { left: auto; right: 16px; bottom: 32px; }
.brain .summary-panel { max-width: 90%; }
.brain #map-detail-close { margin-bottom: 20px; flex-shrink: 0; }
.brain .detail-content { min-height: 0; }
.brain .detail-content #unity-content-container { padding-right: 4px; padding-bottom: 16px; }
.brain .structure-inspector .eyebrow { margin-bottom: 10px; }
.brain .structure-inspector .detail-title { margin-bottom: 16px; }
.brain .structure-inspector Foldout { margin-top: 12px; margin-bottom: 10px; }
.brain .structure-inspector .quiet { margin-top: 8px; -unity-text-align: middle-left; }
.brain .structure-inspector .review-acknowledgement { margin-top: 10px; margin-bottom: 12px; }
.brain .review-section { margin-top: 16px; margin-bottom: 12px; padding-top: 16px; border-top-width: 1px; border-top-color: #50535a; }
.brain .review-acknowledgement .unity-toggle__input { align-items: flex-start; min-width: 0; flex-shrink: 1; }
.brain .review-acknowledgement .unity-toggle__text { white-space: normal; min-width: 0; flex-shrink: 1; margin-left: 8px; }
.brain .domain-navigation .muted { margin-top: 14px; margin-bottom: 12px; }
.brain .map-count { right: 20px; }
.brain .map-header { position: absolute; top: 0; left: 0; right: 0; height: 70px; background-color: #303234; }
.brain .map-heading { right: 180px; }
.brain .filter-panel { top: auto; bottom: 88px; }
.brain .map-legend { bottom: 8px; right: 16px; }
